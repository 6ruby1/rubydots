      <color name="border_highlight" value="#606eb1" /> <!-- darken(comment, 0.8) -->
      <color name="border" value="${black}" />
      <color name="bg_popup" value="${bg_dark}" />
      <color name="bg_statusline" value="${bg_dark}" />
      <color name="bg_sidebar" value="${bg}" />
      <color name="bg_float" value="${bg}" />
      <color name="bg_visual" value="#414974" /> <!-- darken(comment, 0.4) -->

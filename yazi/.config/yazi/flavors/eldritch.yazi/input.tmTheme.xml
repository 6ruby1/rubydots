      <!-- <color name="@" value="${}" /> -->

      <!-- Base colour palette-->

      <color name="none" value="NONE" />
      <color name="bg_dark" value="#171928" />
      <color name="bg" value="#212337" />
      <color name="bg_highlight" value="#292e42" />
      <color name="terminal_black" value="#414868" />


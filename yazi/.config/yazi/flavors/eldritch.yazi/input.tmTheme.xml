      <color name="pink" value="#f265b5" />
      <color name="purple" value="#a48cf2" />
      <color name="lighten_purple_08" value="#b2a2f4" />
      <color name="orange" value="#f7c67f" />
      <color name="yellow" value="#f1fc79" />
      <color name="dark_yellow" value="#c0c95f" />
      <color name="green" value="#37f499" />
      <color name="bright_green" value="#00FA82" />
      <color name="dark_green" value="#33C57F" />
      <color name="red" value="#f16c75" />
      <color name="bright_red" value="#f0313e" />


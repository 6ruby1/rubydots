      <color name="fg_gutter" value="#3b4261" />
      <color name="fg_gutter_light" value="#7081d0" />
      <color name="dark3" value="#6473B7" />
      <color name="comment" value="#7081d0" />
      <color name="dark5" value="#5866A2" />
      <color name="bright_cyan" value="#39DDFD" />
      <color name="visual" value="#76639e" />

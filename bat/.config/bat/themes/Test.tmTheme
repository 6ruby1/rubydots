          <string>#7081d0</string> <!-- bg_search -->
          <key>invisibles</key>
          <string>#5866A2</string> <!-- dark5 -->
          <key>lineHighlight</key>
          <string>#37f499</string> <!-- CursorLineNr -->
          <key>phantomCss</key>
          <string>&lt;![CDATA[ html { position: relative; } ]]&gt;</string>
          <key>popupCss</key>
          <string>&lt;![CDATA[ html { color: #ebfafa; background-color: #212337; padding: 10px; } a
            { color: #04d1f9; line-height: 1.2; text-decoration: none; } .error, .deleted { color:
            #f16c75; } .success, .inserted { color: #37f499; } .warning, .modified { color: #f1fc79;
            } ]]&gt;</string>
          <key>selection</key>
          <string>#76639e</string> <!-- Visual -->
          <key>shadow</key>
          <string>#171928</string> <!-- bg_dark -->
          <key>stackGuide</key>
          <string>#ABB4DA</string> <!-- fg_dark -->
          <key>tagsOptions</key>
          <string>underline</string>
        </dict>
      </dict>

      <!-- Italics
      - Comment
      - @markup.emphasis
      -->
      <dict>
        <key>name</key>
        <string>Italics - Comments, Storage, Keyword Flow, Vue attributes, Decorators</string>
        <key>scope</key>
        <string>comment, meta.var.expr storage.type, keyword.control.flow, meta.directive.vue
          punctuation.separator.key-value.html, meta.directive.vue entity.other.attribute-name.html,
          tag.decorator.js entity.name.tag.js, tag.decorator.js punctuation.definition.tag.js,
          storage.modifier</string>
        <key>settings</key>
        <dict>
          <key>fontStyle</key>
          <string>italic</string>
        </dict>
      </dict>


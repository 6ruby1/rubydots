      <dict>
        <key>settings</key>
        <dict>
          <key>activeGuide</key>
          <string>#6473B7</string> <!-- dark3 -->
          <key>background</key>
          <string>#212337</string> <!-- bg -->
          <key>caret</key>
          <string>#f1fc79</string> <!-- yellow -->
          <key>findHighlight</key>
          <string>#f7c67f</string> <!-- FindHighlightBackground -->
          <key>findHighlightForeground</key>
          <string>#212337</string> <!-- FindHighlightForeground -->
          <key>foreground</key>
          <string>#ebfafa</string> <!-- fg -->
          <key>guide</key>
          <string>#3b4261</string> <!-- fg_gutter -->
          <key>gutterForeground</key>
          <string>#3b4261</string> <!-- fg_gutter -->

# Enhanced completion for specific options
_arguments_for_copilot() {
  case $words[CURRENT-1] in
    --allow-tool|--deny-tool)
      _copilot_tools
      ;;
    --log-level)
      _copilot_log_levels
      ;;
    --add-dir|--log-dir)
      _directories
      ;;
    --resume)
      _copilot_sessions
      ;;
  esac
}

# Register the completion function
compdef _copilot copilot

# Also provide completions for common interactive commands if used with -p
_copilot_prompt_completion() {
  if [[ $words[CURRENT-1] == "-p" || $words[CURRENT-1] == "--prompt" ]]; then
    _message 'enter your prompt text'
  fi
}

# Alternative completion for when copilot is used with specific patterns
_copilot "$@"
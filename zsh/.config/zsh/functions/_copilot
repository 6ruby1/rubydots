#compdef copilot

# Zsh completion for GitHub Copilot CLI
# Place this file in your zsh completion directory or source it directly

_copilot() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '--add-dir[Add a directory to the allowed list for file access]:directory:_directories' \
    '--allow-all-tools[Allow all tools to run automatically without confirmation]' \
    '--allow-tool[Allow specific tools]:tools:' \
    '--banner[Always show the animated banner on startup]' \
    '--deny-tool[Deny specific tools]:tools:' \
    '--disable-mcp-server[Disable a specific MCP server]:server-name:' \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '--log-dir[Set log file directory]:directory:_directories' \
    '--log-level[Set the log level]:level:(error warning info debug all default none)' \
    '--no-color[Disable all color output]' \
    '(-p --prompt)'{-p,--prompt}'[Execute a prompt directly without interactive mode]:text:' \
    '--resume[Resume from a previous session]:sessionId:_copilot_sessions' \
    '--screen-reader[Enable screen reader optimizations]' \
    '(-v --version)'{-v,--version}'[Show version information]' \
    '1:command:_copilot_commands' \
    '*::arg:->args'

  case $state in
    args)
      case $words[1] in
        help)
          _copilot_help_topics
          ;;
      esac
      ;;
  esac
}

_copilot_commands() {
  local commands=(
    'help:Display help information'
  )
  _describe 'commands' commands
}

_copilot_help_topics() {
  local topics=(
    'config:Configuration Settings'
    'environment:Environment Variables'
    'logging:Logging'
    'permissions:Tool Permissions'
  )
  _describe 'help topics' topics
}

_copilot_sessions() {
  # Get available session IDs from copilot logs or config
  # This is a placeholder - actual implementation would need to parse session files
  local sessions=()
  
  # Check for session files in the default log directory
  if [[ -d ~/.copilot/logs ]]; then
    sessions=($(ls ~/.copilot/logs/ 2>/dev/null | grep -E '^session-' | sed 's/session-//' | sed 's/\.log$//' 2>/dev/null))
  fi
  
  if (( ${#sessions[@]} > 0 )); then
    _describe 'session IDs' sessions
  else
    _message 'no sessions found'
  fi
}

